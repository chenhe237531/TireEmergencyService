# 微信云托管 · 环境变量模板
#
# 填在哪里：手动上传代码包时在首次发布的「高级设置」里填；已发布过则改「服务设置 → 基本信息 → 环境变量」，
# 改完需要重新部署（或重新发布一个版本）才生效。
# 注意：本文件只是模板，真实的 JWT_SECRET / 数据库密码不要提交到仓库。

# 必填：生产环境（NODE_ENV=production）缺失时容器会直接启动失败
JWT_SECRET=

# 数据库：云托管 MySQL 若是「单独开通」而非模板部署自动开通，下面四个变量不会被自动注入，必须手填
# MYSQL_ADDRESS 要带端口，例如 10.0.0.1:3306
DB_PROVIDER=mysql
MYSQL_ADDRESS=
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tire

# 首次初始化管理员密码；不填则随机生成并打印在启动日志里（登录后建议立刻改密）
INITIAL_ADMIN_PASSWORD=
# 运营账号（可选，不设则不创建）
INITIAL_OPS_PASSWORD=

# 小程序真实登录：不配置 WX_APPID / WX_SECRET 时必须保持 ALLOW_DEMO_LOGIN=0
WX_APPID=
WX_SECRET=

# 生产都填 0；演示环境可设 SEED_DEMO=1 写入示例门店/司机/工单
SEED_DEMO=0
ALLOW_DEMO_LOGIN=0
