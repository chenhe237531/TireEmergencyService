{
  "name": "tire-server",
  "version": "0.1.0",
  "private": true,
  "description": "小蚂蚁轮胎救援平台 API（NestJS + Prisma）",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "node prisma/db.js generate",
    "db:push": "node prisma/db.js push",
    "db:seed": "node prisma/db.js seed",
    "db:init": "node prisma/db.js init",
    "db:reset": "node prisma/db.js reset"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/serve-static": "^5.0.3",
    "@prisma/client": "6.19.3",
    "dayjs": "^1.11.13",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0"
  }
}
