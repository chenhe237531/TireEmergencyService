# .env 模板：复制为 apps/server/.env 后按需修改（.env 不入库）
DATABASE_URL=file:./tire.db
PORT=3100

# 生产环境必须设置为随机长字符串（至少 32 字符），缺失时生产环境会直接启动失败。
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 不要用下方注释里的占位值直接启动生产！
# JWT_SECRET=

# 初始化数据：默认（不设置）本地开发写演示门店/司机/工单，生产只写管理员、设置、FAQ。
# 演示 / 预发环境想写入完整演示数据时才显式设为 1
# SEED_DEMO=1
INITIAL_ADMIN_USERNAME=admin
# 不填时：本地开发用 admin123；生产环境随机生成并打印在启动日志中
# INITIAL_ADMIN_PASSWORD=
# INITIAL_OPS_PASSWORD=

# 短信验证码：生产必须设置 HMAC 密钥，缺失时生产环境直接启动失败
# SMS_CODE_SECRET=请替换为随机长字符串
# 本地演示验证码（仅非生产环境生效，默认 123456）
# SMS_DEMO_CODE=123456

# 微信登录：配置后自动启用 code2Session 与手机号快速验证
# 未配置时本地开发允许演示登录；生产默认关闭，显式设 ALLOW_DEMO_LOGIN=1 才开启
# WX_APPID=wx0000000000000000
# WX_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ALLOW_DEMO_LOGIN=1
