NODE_ENV = 'production'
# 小程序 AppID：manifest.config.ts 读取后写入 mp-weixin.appid，最终体现在产物 project.config.json。
# 必须与公众平台的正式 AppID 一致；沿用 .env 里的 touristappid（测试号）会导致开发者工具「上传」按钮不可用。
VITE_WX_APPID = 'wx23d49f0032441708'
VITE_DELETE_CONSOLE = true
VITE_SHOW_SOURCEMAP = false
# H5 与接口同域部署：/h5/ 页面，/api/v1 接口
VITE_APP_PUBLIC_BASE = /h5/
VITE_SERVER_BASEURL = '/api/v1'
# 小程序接口地址：微信云托管公网默认域名（环境 little-ant / 服务 little-ant-001）。
# 该域名仅用于联调，浏览器侧有访问时限，小程序 request 不受影响；
# 正式发布前替换为已备案的自定义域名，并同步更新公众平台的 request / uploadFile 合法域名
VITE_MP_SERVER_BASEURL = 'https://little-ant-333266-12-1513689208.sh.run.tcloudbase.com/api/v1'
# 安卓 App 后台地址：生产环境强制 HTTPS（启动时校验，明文地址会直接报错）
VITE_APP_SERVER_BASEURL = 'https://api.example.com/api/v1'
# 微信云托管：填写环境 ID 与服务名后，小程序接口改走 wx.cloud.callContainer（无需合法域名与备案）
VITE_WX_CLOUD_ENV = ''
VITE_WX_CLOUD_SERVICE = ''
