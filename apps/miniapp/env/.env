VITE_APP_TITLE = '小蚂蚁轮胎救援'
VITE_APP_PORT = 9100

VITE_UNI_APPID = '__UNI__TIRE001'
# 小程序 AppID：touristappid 为微信开发者工具测试号（仅支持工具内调试与真机预览）；
# 拿到正式 AppID 后替换，并在 apps/server/.env 配置 WX_APPID / WX_SECRET 启用真实微信登录
VITE_WX_APPID = 'touristappid'

# h5部署网站的base
VITE_APP_PUBLIC_BASE=/

# 后端接口地址（开发环境；真机预览时改为电脑局域网 IP，手机需与电脑同一 Wi-Fi）
VITE_SERVER_BASEURL = 'http://localhost:3100/api/v1'
# 微信小程序专用后台地址（需 HTTPS + 在小程序后台配置合法域名；开发者工具里可勾选「不校验合法域名」）
VITE_MP_SERVER_BASEURL = 'http://localhost:3100/api/v1'
# 安卓 App（app-plus）专用后台地址；H5 继续走相对路径，小程序仍用 VITE_MP_SERVER_BASEURL
# 真机联调时改为电脑局域网 IP，例如 http://192.168.1.10:3100/api/v1
VITE_APP_SERVER_BASEURL = 'http://localhost:3100/api/v1'

VITE_APP_PROXY_ENABLE = false
VITE_APP_PROXY_PREFIX = '/fg-api'
VITE_APP_ROUTER_MODE = hash
VITE_SERVER_BASEURL_SECONDARY = ''
VITE_AUTH_MODE = 'single'
VITE_COPY_NATIVE_RES_ENABLE = false
