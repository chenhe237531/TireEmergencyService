{
  "containerPort": 80,
  "dockerfilePath": "Dockerfile",
  "buildDir": "",
  "minNum": 1,
  "maxNum": 3,
  "cpu": 1,
  "mem": 2,
  "policyType": "cpu",
  "policyThreshold": 80,
  "envParams": {
    "DB_PROVIDER": "mysql",
    "MYSQL_DATABASE": "tire",
    "SEED_DEMO": "0",
    "ALLOW_DEMO_LOGIN": "0"
  },
  "customLogs": "stdout",
  "initialDelaySeconds": 10,
  "dataBaseName": "tire",
  "executeSQLs": [
    "CREATE DATABASE IF NOT EXISTS tire DEFAULT CHARACTER SET utf8mb4;"
  ]
}
